    Write-MenuTitle "CUSTOMIZE WINDOWS 11"
    Write-Host "1. System theming"
    Write-Host "2. Taskbar settings"
    Write-Host "3. Input settings"
    Write-Host "4. Software center"
    Write-Host "5. Uninstall programs"
    Write-Host "6. Utilities"
    Write-Host "7. Download Games"
    Write-Host "0. Exit"

    $choice = Read-Host "Choose an option"

    switch ($choice) {
        "1" { Show-ThemingMenu }
        "2" { Show-TaskbarMenu }
        "3" { Show-InputMenu }
        "4" { Show-SoftwareMenu }
        "5" { Show-UninstallMenu }
        "6" { Show-UtilitiesMenu }
        "7" { Show-GamesMenu }
        "0" { exit }
        default { Write-Host "Invalid choice."; Pause-Toolkit }
    }
}
