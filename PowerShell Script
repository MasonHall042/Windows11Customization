function Restart-ExplorerSafely {
    Write-Host "Refreshing Windows Explorer..." -ForegroundColor Yellow

    try {
        Get-Process explorer -ErrorAction SilentlyContinue |
            Stop-Process -Force -ErrorAction SilentlyContinue

        Start-Sleep -Seconds 2

        if (-not (Get-Process explorer -ErrorAction SilentlyContinue)) {
            Start-Process "$env:WINDIR\explorer.exe"
            Start-Sleep -Seconds 2
        }

        if (Get-Process explorer -ErrorAction SilentlyContinue) {
            Write-Host "Windows Explorer is running." -ForegroundColor Green
        }
        else {
            Write-Host "Start explorer.exe from Task Manager if the taskbar does not return." -ForegroundColor Yellow
        }
    }
    catch {
        Write-Host "Could not refresh Explorer: $_" -ForegroundColor Red
    }
}

function Show-ThemeStatus {
    Write-MenuTitle "CURRENT THEME"

    $path = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize"

    try {
        $settings = Get-ItemProperty -LiteralPath $path -ErrorAction Stop

        $appMode = if ($settings.AppsUseLightTheme -eq 0) { "Dark" } else { "Light" }
        $systemMode = if ($settings.SystemUsesLightTheme -eq 0) { "Dark" } else { "Light" }

        Write-Host "App appearance:    $appMode"
        Write-Host "System appearance: $systemMode"
    }
    catch {
        Write-Host "Could not read theme settings: $_" -ForegroundColor Red
    }

    Pause-Toolkit
}

function Set-WindowsTheme {
    while ($true) {
        Write-MenuTitle "SYSTEM THEMING"
        Write-Host "1. Dark mode"
        Write-Host "2. Light mode"
        Write-Host "3. Open Windows color settings"
        Write-Host "4. Check current theme"
        Write-Host "0. Back"

        $choice = Read-Host "Choose an option"

        if ($choice -eq "0") { return }

        if ($choice -eq "3") {
            Start-Process "ms-settings:personalization-colors"
            continue
        }

        if ($choice -eq "4") {
            Show-ThemeStatus
            continue
        }

        if ($choice -ne "1" -and $choice -ne "2") {
            Write-Host "Invalid choice."
            Pause-Toolkit
            continue
        }

        $value = 1
        $name = "Light"
        if ($choice -eq "1") {
            $value = 0
            $name = "Dark"
        }

        $path = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize"

        try {
            Set-RegistryDword -Path $path -Name "AppsUseLightTheme" -Value $value
            Set-RegistryDword -Path $path -Name "SystemUsesLightTheme" -Value $value

            $check = Get-ItemProperty -LiteralPath $path -ErrorAction Stop

            if ([int]$check.AppsUseLightTheme -ne $value -or
                [int]$check.SystemUsesLightTheme -ne $value) {
                throw "Theme values did not verify correctly."
            }

            Write-Host "$name mode settings saved." -ForegroundColor Green
            Write-Host "Explorer will refresh; the taskbar may disappear briefly."
            Restart-ExplorerSafely
        }
        catch {
            Write-Host "Could not apply the theme: $_" -ForegroundColor Red
            Start-Process "ms-settings:personalization-colors"
        }

        Pause-Toolkit
    }
}

