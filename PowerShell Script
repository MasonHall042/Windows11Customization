
$folder = Join-Path $HOME "Downloads"
$script = Join-Path $folder "Software_Download_Center.ps1"

New-Item -ItemType Directory -Path $folder -Force | Out-Null

@'
$ErrorActionPreference = "Continue"

function Install-App {
    param([string]$Name, [string]$Id, [string]$Url)

    if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
        Write-Host "winget isn't available. Opening official download page..."
        Start-Process $Url
        return
    }

    $confirm = Read-Host "Install $Name? (Y/N)"
    if ($confirm -notin @("Y","y")) { return }

    winget install --id $Id --exact --source winget
}

function Download-WordPress {
    $dest = Join-Path $HOME "Downloads\wordpress-latest.zip"
    $confirm = Read-Host "Download WordPress ZIP to Downloads? (Y/N)"
    if ($confirm -notin @("Y","y")) { return }

    try {
        Invoke-WebRequest -Uri "https://wordpress.org/latest.zip" -OutFile $dest
        Write-Host "Downloaded to: $dest"
        Write-Host "This downloads the files; a web server is needed to run WordPress locally."
    } catch {
        Write-Host "Download failed: $($_.Exception.Message)"
    }
}

while ($true) {
    Clear-Host
    Write-Host "=================================="
    Write-Host "   WINDOWS UTILITIES TOOLKIT"
    Write-Host "=================================="
    Write-Host "1. Windows system information"
    Write-Host "2. Check storage"
    Write-Host "3. Open temporary folder"
    Write-Host "4. Install Firefox"
    Write-Host "5. Install GitHub Desktop"
    Write-Host "6. Install Git"
    Write-Host "7. Install Visual Studio Code"
    Write-Host "8. Download WordPress ZIP"
    Write-Host "9. Open GitHub website"
    Write-Host "10. Open WordPress.com"
    Write-Host "0. Exit"
    Write-Host ""

    $choice = Read-Host "Choose an option"

    switch ($choice) {
        "1" {
            Get-ComputerInfo |
                Select-Object WindowsProductName, WindowsVersion, OsArchitecture |
                Format-List
        }
        "2" {
            Get-PSDrive -PSProvider FileSystem |
                Select-Object Name, Used, Free | Format-Table -AutoSize
        }
        "3" { Start-Process $env:TEMP }
        "4" { Install-App "Firefox" "Mozilla.Firefox" "https://www.mozilla.org/firefox/" }
        "5" { Install-App "GitHub Desktop" "GitHub.GitHubDesktop" "https://desktop.github.com/" }
        "6" { Install-App "Git" "Git.Git" "https://git-scm.com/install/windows" }
        "7" { Install-App "Visual Studio Code" "Microsoft.VisualStudioCode" "https://code.visualstudio.com/" }
        "8" { Download-WordPress }
        "9" { Start-Process "https://github.com/" }
        "10" { Start-Process "https://wordpress.com/" }
        "0" { break }
        default { Write-Host "Choose a valid menu number." }
    }

    if ($choice -eq "0") { break }
    Write-Host ""
    Read-Host "Press Enter to return to the menu" | Out-Null
}
'@ | Set-Content -Path $script -Encoding UTF8

Write-Host "Toolkit created at: $script"
& $script
