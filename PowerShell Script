# ==========================================
# FLOATING SANDBOX INSTALLATION
# ==========================================

function Test-FloatingSandboxInstalled {
    $candidates = @(
        (Join-Path $env:ProgramFiles "Floating Sandbox\FloatingSandbox.exe"),
        (Join-Path ${env:ProgramFiles(x86)} "Floating Sandbox\FloatingSandbox.exe"),
        (Join-Path $env:LOCALAPPDATA "Programs\Floating Sandbox\FloatingSandbox.exe")
    )

    foreach ($candidate in $candidates) {
        if ($candidate -and (Test-Path -LiteralPath $candidate)) {
            return $candidate
        }
    }

    $startMenuPaths = @(
        (Join-Path $env:APPDATA "Microsoft\Windows\Start Menu\Programs"),
        (Join-Path $env:ProgramData "Microsoft\Windows\Start Menu\Programs")
    )

    foreach ($folder in $startMenuPaths) {
        if (Test-Path -LiteralPath $folder) {
            $shortcut = Get-ChildItem -LiteralPath $folder -Filter "*Floating*Sandbox*.lnk" -Recurse -ErrorAction SilentlyContinue |
                Select-Object -First 1

            if ($shortcut) {
                return $shortcut.FullName
            }
        }
    }

    return $null
}

function Install-FloatingSandbox {
    Write-MenuTitle "FLOATING SANDBOX INSTALLER"

    $existing = Test-FloatingSandboxInstalled

    if ($existing) {
        Write-Host "Floating Sandbox appears to be installed:" -ForegroundColor Green
        Write-Host $existing
        $launch = Read-Host "Launch the game now? (Y/N)"

        if ($launch -match "^(Y|YES)$") {
            Start-Process -FilePath $existing
        }

        Pause-Toolkit
        return
    }

    Write-Host "Step 1: Checking whether WinGet has a matching package."
    $winget = Get-Command winget.exe -ErrorAction SilentlyContinue
    $installedByWinget = $false

    if ($winget) {
        try {
            & $winget.Source install --name "Floating Sandbox" --exact --source winget --accept-package-agreements --accept-source-agreements

            if ($LASTEXITCODE -eq 0) {
                Start-Sleep -Seconds 3
                $existing = Test-FloatingSandboxInstalled

                if ($existing) {
                    $installedByWinget = $true
                }
            }
        }
        catch {
            Write-Host "WinGet could not install the game. Continuing with the official download route." -ForegroundColor Yellow
        }
    }

    if ($installedByWinget) {
        Write-Host "Floating Sandbox installation was verified." -ForegroundColor Green
        $launch = Read-Host "Launch the game now? (Y/N)"
        if ($launch -match "^(Y|YES)$") {
            Start-Process -FilePath $existing
        }
        Pause-Toolkit
        return
    }

    Write-Host ""
    Write-Host "WinGet did not provide a verified installation."
    Write-Host "Opening the official download page."
    Write-Host "Download the Windows 64-bit installer if your Windows is 64-bit."
    Write-Host "Avoid the Game Jolt desktop client; use the browser download."
    Start-Process "https://gamejolt.com/games/floating-sandbox/353572"

    Write-Host ""
    Write-Host "After the installer downloads, save it in your Downloads folder."
    Write-Host "This script will look for a Floating Sandbox MSI there."
    Read-Host "Press Enter after the download finishes"

    $installer = Get-ChildItem -LiteralPath (Join-Path $HOME "Downloads") -File -Filter "*.msi" -ErrorAction SilentlyContinue |
        Where-Object { $_.Name -match "floating.*sandbox|sandbox.*floating" } |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

    if (-not $installer) {
        Write-Host "No matching installer was found in Downloads." -ForegroundColor Yellow
        Write-Host "Nothing was installed. Download the official Windows installer and run Option 1 again."
        Pause-Toolkit
        return
    }

    Write-Host ""
    Write-Host "Found installer: $($installer.Name)"
    Write-Host "The Windows Installer may request confirmation or administrator permission."
    $confirm = Read-Host "Run this installer now? (Y/N)"

    if ($confirm -notmatch "^(Y|YES)$") {
        Write-Host "Installation cancelled."
        Pause-Toolkit
        return
    }

    try {
        $process = Start-Process -FilePath "msiexec.exe" `
            -ArgumentList @("/i", "`"$($installer.FullName)`"") `
            -Wait -PassThru

        if ($process.ExitCode -eq 0) {
            Start-Sleep -Seconds 3
            $existing = Test-FloatingSandboxInstalled

            if ($existing) {
                Write-Host "Floating Sandbox is installed." -ForegroundColor Green
                $launch = Read-Host "Launch the game now? (Y/N)"
                if ($launch -match "^(Y|YES)$") {
                    Start-Process -FilePath $existing
                }
            }
            else {
                Write-Host "The installer completed, but the game executable was not found in the usual locations." -ForegroundColor Yellow
                Write-Host "Check the Start menu for Floating Sandbox."
            }
        }
        elseif ($process.ExitCode -eq 1602) {
            Write-Host "Installation was cancelled." -ForegroundColor Yellow
        }
        else {
            Write-Host "Windows Installer returned exit code $($process.ExitCode)." -ForegroundColor Red
        }
    }
    catch {
        Write-Host "Could not run the installer: $_" -ForegroundColor Red
    }

    Pause-Toolkit
}

