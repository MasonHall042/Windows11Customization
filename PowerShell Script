# ==========================================
# UNINSTALL PROGRAMS
# ==========================================

function Get-InstalledDesktopPrograms {
    # Read standard uninstall registry entries only. This avoids Win32_Product,
    # which can trigger Windows Installer consistency checks/repairs.
    $registryPaths = @(
        'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*',
        'HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*',
        'HKLM:\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*'
    )

    $apps = foreach ($registryPath in $registryPaths) {
        Get-ItemProperty -Path $registryPath -ErrorAction SilentlyContinue |
            Where-Object {
                $_.DisplayName -and
                ($_.UninstallString -or $_.QuietUninstallString) -and
                $_.SystemComponent -ne 1 -and
                -not $_.ParentKeyName -and
                $_.ReleaseType -notmatch 'Update|Hotfix|Security Update'
            } |
            ForEach-Object {
                [PSCustomObject]@{
                    Name               = ([string]$_.DisplayName).Trim()
                    Version            = [string]$_.DisplayVersion
                    Publisher          = [string]$_.Publisher
                    InstallLocation    = [string]$_.InstallLocation
                    UninstallString    = [string]$_.UninstallString
                    QuietUninstall     = [string]$_.QuietUninstallString
                    RegistryKey        = [string]$_.PSPath
                    RegistryName       = [string]$_.PSChildName
                    WindowsInstaller   = [int]$_.WindowsInstaller
                }
            }
    }

    # De-duplicate entries visible through multiple registry views.
    $apps |
        Sort-Object Name, Version, RegistryKey -Unique |
        Sort-Object Name, Publisher
}

function Invoke-RegisteredUninstaller {
    param([Parameter(Mandatory = $true)]$Program)

    $command = if (-not [string]::IsNullOrWhiteSpace($Program.QuietUninstall)) {
        [string]$Program.QuietUninstall
    }
    else {
        [string]$Program.UninstallString
    }

    if ([string]::IsNullOrWhiteSpace($command)) {
        throw 'Windows has no registered uninstall command for this program.'
    }

    $command = [Environment]::ExpandEnvironmentVariables($command.Trim())

    # MSI packages should be removed with /x, not /i. Use the product GUID
    # when available, and leave the uninstall UI interactive where possible.
    if ($command -match '(?i)msiexec(?:\.exe)?' -or $Program.WindowsInstaller -eq 1) {
        $guidMatch = [regex]::Match($command, '\{[0-9A-Fa-f]{8}-(?:[0-9A-Fa-f]{4}-){3}[0-9A-Fa-f]{12}\}')
        if ($guidMatch.Success) {
            $arguments = "/x $($guidMatch.Value)"
            $process = Start-Process -FilePath 'msiexec.exe' -ArgumentList $arguments -Wait -PassThru
            return $process.ExitCode
        }

        $arguments = $command -replace '(?i)^.*?msiexec(?:\.exe)?\s*', ''
        $arguments = $arguments -replace '(?i)(^|\s)/i(?=\s|\{)', '$1/x'
        if ($arguments -notmatch '(?i)(^|\s)/x(\s|$)') {
            $arguments = "/x $arguments"
        }
        $process = Start-Process -FilePath 'msiexec.exe' -ArgumentList $arguments -Wait -PassThru
        return $process.ExitCode
    }

    # Split the registered command into executable and arguments without
    # running it through cmd.exe. Support quoted and unquoted .exe paths.
    $exe = $null
    $arguments = ''

    if ($command -match '^\s*"(?<exe>[^"]+\.exe)"\s*(?<args>.*)$') {
        $exe = $Matches.exe
        $arguments = $Matches.args
    }
    elseif ($command -match '^\s*(?<exe>.+?\.exe)\s*(?<args>.*)$') {
        $exe = $Matches.exe.Trim().Trim('"')
        $arguments = $Matches.args
    }
    else {
        throw "The registered uninstall command is not a supported executable command: $command"
    }

    if (-not (Test-Path -LiteralPath $exe -PathType Leaf)) {
        # Some entries rely on PATH resolution (for example, rundll32.exe).
        $resolved = Get-Command $exe -ErrorAction SilentlyContinue
        if ($resolved) { $exe = $resolved.Source }
        else { throw "The uninstaller executable could not be found: $exe" }
    }

    $process = Start-Process -FilePath $exe -ArgumentList $arguments -Wait -PassThru
    return $process.ExitCode
}

function Show-UninstallMenu {
    $pageSize = 20
    $page = 0

    while ($true) {
        Write-MenuTitle 'UNINSTALL PROGRAMS'
        Write-Host 'Choose a listed desktop program to start its registered uninstaller.' -ForegroundColor Gray
        Write-Host 'Some programs require administrator permission or cannot be removed by a standard user.' -ForegroundColor Yellow
        Write-Host ''

        $apps = @(Get-InstalledDesktopPrograms)
        if ($apps.Count -eq 0) {
            Write-Host 'No removable desktop programs were found in the uninstall registry.' -ForegroundColor Yellow
            Write-Host 'Microsoft Store/system apps may not appear in this list.'
            Pause-Toolkit
            return
        }

        $pageCount = [math]::Max(1, [math]::Ceiling($apps.Count / [double]$pageSize))
        if ($page -ge $pageCount) { $page = $pageCount - 1 }
        if ($page -lt 0) { $page = 0 }
        $start = $page * $pageSize
        $end = [math]::Min($start + $pageSize - 1, $apps.Count - 1)
        $visibleApps = @($apps[$start..$end])

        for ($i = 0; $i -lt $visibleApps.Count; $i++) {
            $number = $i + 1
            $app = $visibleApps[$i]
            $versionText = if ($app.Version) { " (v$($app.Version))" } else { '' }
            Write-Host ('{0,2}. {1}{2}' -f $number, $app.Name, $versionText)
        }

        Write-Host ''
        Write-Host ("Page {0} of {1} — {2} programs found" -f ($page + 1), $pageCount, $apps.Count) -ForegroundColor Cyan
        if ($page -gt 0) { Write-Host 'P. Previous page' }
        if ($page -lt ($pageCount - 1)) { Write-Host 'N. Next page' }
        Write-Host 'R. Refresh list'
        Write-Host '0. Back'
        $choice = (Read-Host 'Enter a program number or command').Trim()

        if ($choice -eq '0') { return }
        if ($choice -match '^(?i)R$') { $page = 0; continue }
        if ($choice -match '^(?i)N$' -and $page -lt ($pageCount - 1)) { $page++; continue }
        if ($choice -match '^(?i)P$' -and $page -gt 0) { $page--; continue }

        $selection = 0
        if (-not [int]::TryParse($choice, [ref]$selection) -or
            $selection -lt 1 -or $selection -gt $visibleApps.Count) {
            Write-Host 'Invalid selection.' -ForegroundColor Red
            Pause-Toolkit
            continue
        }

        $program = $visibleApps[$selection - 1]
        Write-Host ''
        Write-Host "Selected: $($program.Name)" -ForegroundColor Cyan
        if ($program.Version) { Write-Host "Version: $($program.Version)" }
        if ($program.Publisher) { Write-Host "Publisher: $($program.Publisher)" }
        Write-Host ''
        Write-Host 'The program uninstaller will open normally. Review its prompts before continuing.' -ForegroundColor Yellow
        $confirm = Read-Host "Start uninstall for '$($program.Name)'? (Y/N)"
        if ($confirm -notmatch '^(?i:Y|YES)$') { continue }

        try {
            $exitCode = Invoke-RegisteredUninstaller -Program $program
            if ($exitCode -eq 0) {
                Write-Host 'The uninstaller reported that it completed.' -ForegroundColor Green
            }
            elseif ($exitCode -eq 1602) {
                Write-Host 'The uninstall was cancelled.' -ForegroundColor Yellow
            }
            elseif ($exitCode -eq 3010) {
                Write-Host 'The uninstall completed; Windows says a restart is required.' -ForegroundColor Yellow
            }
            else {
                Write-Host "The uninstaller exited with code $exitCode. It may have been cancelled or may require administrator permission." -ForegroundColor Yellow
            }
        }
        catch {
            Write-Host "Could not start or complete the uninstaller: $($_.Exception.Message)" -ForegroundColor Red
        }

        Write-Host ''
        Read-Host 'Press Enter to refresh the program list'
        $page = 0
    }
}

